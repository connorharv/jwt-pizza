    "globals": "^17.12.0",
    "jest": "^30.5.1",
    "nyc": "^18.0.0",
    "playwright-test-coverage": "^1.2.12",
    "postcss": "^8.4.38",
    "prettier": "3.9.6",
    "supertest": "^7.2.2",
    "tailwindcss": "^3.4.3",
